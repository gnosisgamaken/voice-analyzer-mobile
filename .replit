modules = ["nodejs-22"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TypeScript Check"

[[workflows.workflow]]
name = "TypeScript Check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd app && npx tsc --noEmit --watch"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
